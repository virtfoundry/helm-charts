      "version": 1,
      "versionNonce": 1968381973,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Prod recommended\n- replicated storage (not local-path)\n- CSI VolumeSnapshotClass for volume snaps\n- Ingress/Gateway hostname\n- public net: VLAN if you have switch, else LAN/macvlan\n- multi-worker for capacity; CP HA when SLA needs it\n- OVN when multi-node VPC without underlay VLANs",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "35491d0c63e34855ab39",
      "originalText": "Prod recommended\n- replicated storage (not local-path)\n- CSI VolumeSnapshotClass for volume snaps\n- Ingress/Gateway hostname\n- public net: VLAN if you have switch, else LAN/macvlan\n- multi-worker for capacity; CP HA when SLA needs it\n- OVN when multi-node VPC without underlay VLANs",
      "autoResize": true,
      "lineHeight": 1.25
    },
